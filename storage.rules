rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Photos de déchets postées par les Fournisseurs de déchets (voir
    // CollectionService.uploadWastePhoto) — chacun ne peut écrire que sous
    // son propre uid, mais un collecteur assigné doit pouvoir voir la photo
    // (lecture ouverte à tout utilisateur connecté, comme pour la lecture
    // des demandes `pending` dans firestore.rules).
    match /waste_photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}
