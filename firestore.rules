rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // La vérification de l'email (et du téléphone) se fait uniquement à
    // l'inscription (voir RegisterScreen), jamais à la connexion : les règles
    // n'exigent donc qu'un utilisateur connecté, pour que les comptes créés
    // avant cette vérification continuent de fonctionner normalement.
    function signedIn() {
      return request.auth != null;
    }

    // Une mise à jour ne modifie que les champs listés.
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // L'id d'une conversation est formé des deux uid triés, joints par "_"
    // (voir MessagingService) — les uid Firebase ne contiennent jamais de
    // "_". On sait donc qui y participe sans lire aucun document, ce qui
    // permet aussi de lister les messages d'une conversation encore vide.
    function conversationMembers(conversationId) {
      return conversationId.split('_');
    }

    // Un utilisateur peut lire/créer uniquement sa propre fiche.
    //
    // À la création du compte, `role` et `verificationStatus` sont null
    // (le rôle est choisi juste après, sur RoleSelectionScreen). La mise à
    // jour qui fixe le rôle n'est autorisée qu'une seule fois (transition
    // null -> valeur) et seulement avec la paire cohérente attendue :
    //   - household -> verificationStatus "verified" (immédiat)
    //   - collector -> verificationStatus "verified" (immédiat aussi —
    //     demande explicite : "il ne devrait pas avoir [de validation
    //     admin], il crée juste son compte et puis c'est tout", plus de
    //     statut "pending" pour un Collecteur)
    // Une fois le rôle fixé, ni `role` ni `verificationStatus` ne peuvent
    // plus changer depuis le client.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && (
                         (
                           resource.data.role == null &&
                           (request.resource.data.role == 'household' ||
                            request.resource.data.role == 'collector') &&
                           request.resource.data.verificationStatus == 'verified'
                         ) ||
                         (
                           resource.data.role != null &&
                           request.resource.data.role == resource.data.role &&
                           request.resource.data.verificationStatus == resource.data.verificationStatus
                         )
                       );

      // Un utilisateur peut supprimer sa propre fiche — utilisé uniquement
      // par AuthService.deleteAccount (suppression de compte, voir
      // screens/settings/account_screen.dart).
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Index public en LECTURE SEULE "téléphone -> email", pour permettre à
    // l'onglet "Téléphone" de LoginScreen de retrouver l'email associé et
    // se connecter normalement (Firebase Auth n'a pas de "mot de passe +
    // téléphone"). `get` uniquement (pas `list`) : il faut déjà connaître
    // le numéro exact pour lire l'entrée correspondante, aucune énumération
    // possible. Écrit une seule fois à l'inscription (voir
    // AuthService.registerAccount).
    // Création : seulement vers SON PROPRE email — sinon n'importe qui
    // pourrait associer le numéro d'un autre à une adresse de son choix et
    // bloquer sa connexion par téléphone.
    match /phone_lookup/{phoneNumber} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.email == request.auth.token.email;
      // Suppression : uniquement l'entrée qui pointe vers son propre email
      // (nettoyage lors de AuthService.deleteAccount).
      allow delete: if request.auth != null
                    && resource.data.email == request.auth.token.email;
      allow update: if false;
    }

    // ------------------------------------------------------------------
    // Module Fournisseur de déchets (collectes, portefeuille, parrainage,
    // notifications). Principe directeur : PERSONNE n'écrit jamais dans les
    // données à valeur (points, portefeuille, résumé de parrainage) d'un
    // AUTRE utilisateur — chacun ne peut créditer que son propre solde,
    // toujours avec un id de document déterministe (ex. l'id de la demande)
    // pour qu'un second essai soit rejeté par `allow update: if false`,
    // jamais recompté deux fois. Concrètement (voir CollectionService /
    // WalletService / ReferralService) : le Collecteur écrit uniquement le
    // résultat (poids, statut) sur LA DEMANDE dont il est le collecteur
    // assigné ; c'est ensuite le Fournisseur lui-même qui réclame ses points
    // dans SON PROPRE portefeuille en lisant ce résultat, et le filleul qui
    // qualifie SA PROPRE ligne de parrainage — le parrain réclame alors ses
    // points de parrainage dans SON PROPRE portefeuille à sa prochaine
    // visite. La seule exception restante est l'envoi de notifications à un
    // autre utilisateur (impossible à éviter sans backend) — sans impact sur
    // l'argent ou les points, seulement un risque de spam visuel.
    // ------------------------------------------------------------------

    match /collectionRequests/{requestId} {
      allow create: if signedIn()
                    && request.resource.data.householdUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.collectorUid == null;

      // Le propriétaire voit toujours sa demande ; un collecteur peut lire
      // celles encore libres (pour les proposer à l'acceptation) ainsi que
      // celle qui lui est assignée.
      allow read: if request.auth != null
                  && (resource.data.householdUid == request.auth.uid
                      || resource.data.collectorUid == request.auth.uid
                      || resource.data.status == 'pending');

      // Chaque transition autorisée ne peut toucher QUE ses propres champs
      // (`affectedKeys().hasOnly`) : ni le collecteur ne peut clôturer une
      // collecte ou changer sa commission, ni le fournisseur modifier le
      // poids/prix soumis par le collecteur.
      allow update: if request.auth != null && (
          // Le Fournisseur annule sa propre demande tant qu'elle est libre.
          (resource.data.householdUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && changedOnly(['status']))
          ||
          // Un collecteur accepte une demande encore libre — une seule
          // acceptation possible (le document n'a alors plus `collectorUid
          // == null`, donc une seconde tentative simultanée échoue).
          (resource.data.collectorUid == null
            && resource.data.status == 'pending'
            && request.resource.data.collectorUid == request.auth.uid
            && request.resource.data.status == 'accepted'
            && changedOnly(['collectorUid', 'collectorName', 'status', 'acceptedAt']))
          ||
          // Le collecteur assigné démarre la collecte (suivi en direct).
          (resource.data.collectorUid == request.auth.uid
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'accepted'
            && changedOnly(['collectionStartedAt']))
          ||
          // Le collecteur assigné soumet poids/prix après la rencontre (voir
          // CollectionService.submitCollectionResult), avec un nouveau code
          // pour le QR que le fournisseur devra scanner.
          (resource.data.collectorUid == request.auth.uid
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'inProgress'
            && request.resource.data.pendingWeightKg is number
            && request.resource.data.pendingPriceFcfa is number
            && request.resource.data.scanCode is string
            && changedOnly(['status', 'pendingWeightKg', 'pendingPriceFcfa', 'resultRejected', 'scanCode']))
          ||
          // Le Fournisseur accepte le formulaire après avoir scanné le QR du
          // collecteur : les valeurs définitives sont exactement celles
          // soumises par le collecteur.
          (resource.data.householdUid == request.auth.uid
            && resource.data.status == 'inProgress'
            && request.resource.data.status == 'completed'
            && request.resource.data.weightKg == resource.data.pendingWeightKg
            && request.resource.data.valueFcfa == resource.data.pendingPriceFcfa
            && changedOnly(['status', 'weightKg', 'valueFcfa', 'pointsEarned', 'commissionFcfa',
                            'pendingWeightKg', 'pendingPriceFcfa', 'scanCode', 'completedAt']))
          ||
          // ... ou le refuse : retour à `accepted`, le collecteur resoumettra.
          (resource.data.householdUid == request.auth.uid
            && resource.data.status == 'inProgress'
            && request.resource.data.status == 'accepted'
            && request.resource.data.resultRejected == true
            && changedOnly(['status', 'pendingWeightKg', 'pendingPriceFcfa', 'scanCode', 'resultRejected']))
      );

      allow delete: if false;
    }

    // Photos des déchets postés (voir WastePhotoService), stockées dans
    // Firestore faute de Firebase Storage sur le plan gratuit. Lisibles par
    // tout utilisateur connecté (un collecteur doit voir la photo d'un post
    // libre avant de l'accepter, comme pour les demandes `pending`). Chacun
    // n'enregistre que SES photos : JPEG compressé, moins de 950 Ko.
    // Jamais modifiées ni supprimées depuis l'app.
    match /wastePhotos/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.contentType == 'image/jpeg'
                    && request.resource.data.data is bytes
                    && request.resource.data.data.size() <= 950000;
      allow update, delete: if false;
    }

    // Zones de collecte d'un Collecteur (voir CollectorZoneService), en copie
    // minimale — séparée de `users/{uid}` car TOUT utilisateur connecté doit
    // pouvoir la lire : c'est l'appareil du Fournisseur qui publie un post
    // qui calcule quels collecteurs notifier. Seul le collecteur lui-même
    // l'écrit, 5 zones au plus.
    match /collectorLocations/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
                   && (!('zones' in request.resource.data)
                       || (request.resource.data.zones is list
                           && request.resource.data.zones.size() <= 5));
    }

    // Positions en direct d'une collecte démarrée (voir LiveTrackingService)
    // — id = id de la demande ; seuls son Fournisseur et son Collecteur
    // assigné peuvent lire/écrire, et seulement tant qu'elle n'est pas
    // terminée (suppression permise pour le nettoyage à la confirmation).
    match /liveTracking/{requestId} {
      function isParty() {
        let req = get(/databases/$(database)/documents/collectionRequests/$(requestId)).data;
        return request.auth != null
          && (req.householdUid == request.auth.uid || req.collectorUid == request.auth.uid);
      }
      allow read, delete: if isParty();
      allow create, update: if isParty()
        && get(/databases/$(database)/documents/collectionRequests/$(requestId)).data.status
             in ['accepted', 'inProgress'];
    }

    // Portefeuille à points — voir WalletService. Strictement personnel :
    // seul le propriétaire écrit dans son propre solde, que ce soit pour
    // réclamer des points (collecte, parrainage) ou les convertir.
    match /wallets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /transactions/{txId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        // Jamais de modification/suppression : un id de document déterministe
        // (ex. l'id de la demande de collecte) rend un second crédit pour le
        // même événement impossible à créer une deuxième fois.
        allow update, delete: if false;
      }

      match /redemptions/{redemptionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Index public "code de parrainage -> propriétaire", comme phone_lookup.
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Résumé de parrainage — strictement personnel (voir wallets ci-dessus) :
    // seul le parrain écrit son propre résumé, quand il réclame ses points
    // (voir ReferralService.claimPendingRewards).
    match /referrals/{referrerUid} {
      allow read, write: if request.auth != null && request.auth.uid == referrerUid;

      match /uses/{referredUid} {
        // Le filleul crée sa propre ligne d'usage chez son parrain, à
        // l'inscription (voir ReferralService.recordReferralUse).
        allow create: if request.auth != null
                      && request.auth.uid == referredUid
                      && request.resource.data.status == 'pending';
        allow read: if request.auth != null
                    && (request.auth.uid == referrerUid || request.auth.uid == referredUid);
        // Seul le filleul peut qualifier SA PROPRE ligne, une seule fois
        // (pending -> qualified uniquement, jamais l'inverse ni un montant
        // arbitraire — voir RewardsConfig.referralPoints, dupliqué ici en dur
        // car les règles ne peuvent pas importer le code Dart).
        allow update: if request.auth != null
                      && request.auth.uid == referredUid
                      && resource.data.status == 'pending'
                      && request.resource.data.status == 'qualified'
                      && request.resource.data.pointsAwarded == 50;
        allow delete: if false;
      }
    }

    // Centre de notifications — voir NotificationService. Chacun peut créer
    // ses propres notifications ; un collecteur peut aussi notifier le
    // Fournisseur de LA demande à laquelle il est réellement assigné, et un
    // Fournisseur peut notifier n'importe quel Collecteur qu'un de ses
    // propres posts est proche (voir CollectionService._notifyNearbyCollectors)
    // — seules exceptions "écriture chez un autre utilisateur" du fichier,
    // toutes deux sans impact sur l'argent/les points, juste un risque de
    // spam visuel.
    function isPartyPair(requestId, a, b) {
      let req = get(/databases/$(database)/documents/collectionRequests/$(requestId)).data;
      return (req.householdUid == a && req.collectorUid == b)
          || (req.collectorUid == a && req.householdUid == b);
    }

    match /notifications/{uid} {
      match /items/{itemId} {
        allow read, update: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && (
            request.auth.uid == uid
            // Les deux parties d'une même demande se notifient l'une l'autre
            // (acceptation, démarrage, formulaire soumis, confirmation, refus).
            || (request.resource.data.relatedRequestId is string
                && isPartyPair(request.resource.data.relatedRequestId, request.auth.uid, uid))
            || (request.resource.data.type == 'newNearbyPost'
                && request.resource.data.relatedRequestId is string
                && get(/databases/$(database)/documents/collectionRequests/$(request.resource.data.relatedRequestId)).data.householdUid == request.auth.uid)
        );
        allow delete: if false;
      }
    }

    // Note laissée par le Fournisseur au Collecteur après une collecte
    // terminée — une seule par collecte (id = requestId).
    match /ratings/{requestId} {
      allow read: if request.auth != null;
      allow create: if signedIn()
                    && request.resource.data.householdUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Messagerie directe Fournisseur <-> Collecteur — voir MessagingService.
    // Un document par PAIRE d'utilisateurs (id déterministe = les deux uid
    // triés), lisible/modifiable seulement par ses deux participants ; la
    // paire elle-même (`participants`) ne peut plus changer une fois créée.
    match /conversations/{conversationId} {
      // Premier cas : lecture d'UNE conversation (même pas encore créée) ;
      // second : la liste "mes conversations" (filtre array-contains).
      allow read: if request.auth != null
                  && (request.auth.uid in conversationMembers(conversationId)
                      || request.auth.uid in resource.data.participants);

      allow create: if signedIn()
                    && request.auth.uid in conversationMembers(conversationId)
                    && request.resource.data.participants == conversationMembers(conversationId);

      allow update: if request.auth != null
                    && request.auth.uid in conversationMembers(conversationId)
                    && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      // `participants` est dupliqué sur CHAQUE message (pas seulement sur
      // la conversation) exprès : sans ça, la règle devrait relire le
      // document `conversations/{conversationId}` via get() pour savoir qui
      // a le droit d'écrire — or ce document est justement écrit dans LE
      // MÊME lot que le premier message d'une conversation, et l'ordre de
      // visibilité d'un get() sur un document tout juste écrit dans le même
      // batch n'est pas garanti. Dupliquer le champ rend chaque message
      // auto-suffisant, sans dépendre de cet ordre.
      match /messages/{messageId} {
        // Sans dépendre du contenu des messages : Firestore refuse une
        // requête dont il ne peut pas prouver d'avance qu'elle respecte la
        // règle — c'est ce qui bloquait tout le chat.
        allow read: if request.auth != null
                    && request.auth.uid in conversationMembers(conversationId);

        // Chacun n'envoie de message qu'en son propre nom.
        allow create: if signedIn()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.auth.uid in conversationMembers(conversationId)
                      && request.resource.data.participants == conversationMembers(conversationId);

        allow update, delete: if false;
      }
    }
  }
}
