<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Requis par file_selector (PostWasteScreen, photo du déchet) : sans
	     ça, le panneau natif "Ouvrir un fichier" s'affiche mais l'app n'a pas
	     le droit de lire le fichier choisi une fois le panneau fermé. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
